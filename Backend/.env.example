# App database (used by Backend after setup)
# Coolify: use the Postgres INTERNAL URL from your database resource (not localhost).
# App + database must be in the same Coolify project, environment, and server.
# Example: postgresql://postgres:YOUR_DB_PASSWORD@INTERNAL_HOST:5432/postgres?schema=public
#
# If Postgres logs "password authentication failed for user postgres", DATABASE_URL
# does not match the database password — update it in Coolify app env and redeploy.
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/fieldpro?schema=public"

# --- First-time setup only ---
# npm run db:migrate will FAIL until fieldpro user exists.
# Run once (replace with your PostgreSQL admin password):
#   .\scripts\setup-local-db.ps1 -PostgresPassword "YOUR_POSTGRES_PASSWORD"
# Or:
#   $env:POSTGRES_PASSWORD="YOUR_POSTGRES_PASSWORD"; npm run db:init
#
# Alternative: point DATABASE_URL at your postgres superuser until DB exists:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fieldpro?schema=public"

JWT_SECRET="field-pro-dev-secret-change-in-production"
# Production: set a long random secret (min 32 chars). App refuses to start with the default.
PORT=3001
GPS_VERIFY_RADIUS_M=50

# --- Security / abuse protection ---
# Coolify/Traefik hop count for correct client IPs (required for rate limits)
# TRUST_PROXY=1
# Comma-separated browser origins allowed to call the API (production).
# Same-origin SPA on this app usually needs no CORS; set if frontend is on another domain.
# CORS_ORIGINS=https://terrafipro.example.com
# CORS_ALLOW_STAR=false
# Rate limits (defaults are production-safe)
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_REGISTER_MAX=5
# RATE_LIMIT_PUBLIC_MAX=60
# RATE_LIMIT_FLOAT_MAX=120
# RATE_LIMIT_WEBHOOK_MAX=180
# Body size caps
# JSON_BODY_LIMIT=100kb
# WEBHOOK_BODY_LIMIT=256kb
# FLOAT_INGEST_BODY_LIMIT=1mb
# Password policy
# MIN_PASSWORD_LENGTH=8
# Local only: ENABLE_DEMO_USERS=true exposes GET /api/auth/demo-users

# Invite / transactional email (Resend)
# Verify tarafipro.com (or your domain) in the Resend dashboard first.
RESEND_API_KEY=""
# Coolify-safe form (recommended):
RESEND_FROM_EMAIL="info@tarafipro.com"
RESEND_FROM_NAME="Terrafi Pro"
# Alternative single value: RESEND_FROM_EMAIL="Terrafi Pro <info@tarafipro.com>"
# Public app URL used in email buttons (Coolify public URL)
# APP_PUBLIC_URL="https://your-terrafi-domain.com"

# biReports agent float integration (share with biReports out-of-band)
# PARTNER_AGENT_FLOAT_API_URL=https://your-host/api/agent-float
# (also accepts /api/integrations/agent-float)
PARTNER_AGENT_FLOAT_API_KEY=""
PARTNER_AGENT_FLOAT_HMAC_SECRET=""
PARTNER_AGENT_FLOAT_ENCRYPTION_KEY=""
# Company that receives float snapshots (default demo tenant)
PARTNER_AGENT_FLOAT_COMPANY_ID="co-aps"

# --- DirectPay / EasyPay subscription billing ---
# Public base URL of THIS Terrafi Pro app (email sign-in links + DirectPay webhook base).
# Production: https://terrafipro.barakah.site
APP_PUBLIC_URL="http://localhost:3001"
# Optional override for email CTAs only (defaults to APP_PUBLIC_URL):
# FRONTEND_URL="https://terrafipro.barakah.site"
# DirectPay / EasyPay internal-partner API origin
DIRECTPAY_API_BASE_URL=https://dpay.phantommetrics.gm
# Bearer secret for the internal-partner API (= DirectPay INTERNAL_PARTNER_API_SECRET)
DIRECTPAY_INTERNAL_PARTNER_API_SECRET=
# DirectPay web app URL for guest subscription-invoice pay links
DIRECTPAY_PUBLIC_APP_URL=
# HMAC secret to verify inbound subscription webhooks (= DirectPay INTERNAL_PARTNER_WEBHOOK_SECRET)
DIRECTPAY_WEBHOOK_SECRET=
# EasyPay partnerApp value: one of default | analytics-bi | vpay.
DIRECTPAY_PARTNER_APP="analytics-bi"
# Outbound DirectPay HTTP timeout (ms)
DIRECTPAY_TIMEOUT_MS=20000
# Max wait during company registration for DirectPay setup (ms)
DIRECTPAY_REGISTER_TIMEOUT_MS=12000
# Fallback CORPORATE plan amount in Gambian Dalasi when DirectPay omits price
# DIRECTPAY_CORPORATE_MRR_GMD=5000
# Soft-sync billing status if cache is older than this (ms)
# BILLING_STATUS_STALE_MS=20000
# Optional per-tier DirectPay plan codes (default: CORPORATE for all)
# DIRECTPAY_PLAN_BASIC=
# DIRECTPAY_PLAN_STANDARD=
# DIRECTPAY_PLAN_UNLIMITED=
# DIRECTPAY_DEFAULT_PLAN_CODE=CORPORATE
# Public contact shown on /api/plans and Contact page
# SUPPORT_EMAIL=support@terrafi.pro
# SUPPORT_PHONE=
# SUPPORT_ADDRESS=Banjul, The Gambia
# Hourly subscription renewal/grace/lock sweep
# SUBSCRIPTION_SWEEP_MS=3600000

# Platform owner password for production bootstrap (db:seed on empty DB)
# PLATFORM_OWNER_PASSWORD="change-me"

# Load APS Wallet demo dataset locally (npm run db:seed:demo on empty DB)
# SEED_DEMO=true
